// -----------------------------------------------------------------------------
// If a guarded callee never comes back to its stub (it "returns" somewhere
// else and the game faults), the stub's Depth is still 1. The exception
// handler below finds that stub, logs it, and resumes the game exactly as if
// the call had returned normally: ESP/EBX/EBP/ESI/EDI from the stub's copy,
// EAX = the call's normal success value, EIP = the real return address.
// -----------------------------------------------------------------------------
type
  TGuardRef = record
    G : ^TGuardState; Name : string; Site, ArgBytes, OkEax : Cardinal;
  end;

function MyAddVEH(First : ULONG; Handler : Pointer) : Pointer; stdcall;
  external 'kernel32.dll' name 'AddVectoredExceptionHandler';
function MyRemoveVEH(Handle : Pointer) : ULONG; stdcall;
  external 'kernel32.dll' name 'RemoveVectoredExceptionHandler';

var
  VehHandle  : Pointer = nil;
  Recoveries : Integer = 0;

function GuardRef(i : Integer) : TGuardRef;
begin
  case i of
    0: begin result.G := @GA; result.Name := 'HAPI_BroadcastMessage (player info)'; result.Site := $00450CBB; result.ArgBytes := 12; result.OkEax := 0; end;
    1: begin result.G := @GB; result.Name := 'HAPI_BroadcastMessage (0x24 packet)'; result.Site := $00450CF6; result.ArgBytes := 12; result.OkEax := 0; end;
    2: begin result.G := @GC; result.Name := 'NetQueue_Flush(1)'; result.Site := $00450D0B; result.ArgBytes := 4; result.OkEax := 0; end;
    3: begin result.G := @GD; result.Name := 'HAPI_GetPlayerName -> DirectPlay GetPlayerName'; result.Site := $00450B6F; result.ArgBytes := 16; result.OkEax := 0; end;
    4: begin result.G := @GE; result.Name := 'InitPlayerSlot(index,type)'; result.Site := $00450C29; result.ArgBytes := 8; result.OkEax := 0; end;
    5: begin result.G := @GF; result.Name := 'GetTimeMs'; result.Site := $00450C3C; result.ArgBytes := 0; result.OkEax := 0; end;
  else
    result.G := nil;
  end;
end;

function JoinGuardVeh(ep : PExceptionPointers) : LongInt; stdcall;
var
  i, k : Integer;
  r : TGuardRef;
  c : PContext;
  code : Cardinal;
  s : string;
begin
  result := 0;                              // EXCEPTION_CONTINUE_SEARCH
  code := ep^.ExceptionRecord^.ExceptionCode;
  if (code <> $C0000005) and (code <> $C000001D) and (code <> $C0000096) then Exit;
  c := ep^.ContextRecord;
  // only the join-crash pattern: executing inside Network_Add_Player_Remote's
  // body at a bad spot, or at a garbage address below the exe
  if not (((c^.Eip >= $00450A10) and (c^.Eip < $00450D80)) or (c^.Eip < $00400000)) then Exit;
  for i := 0 to 5 do
  begin
    r := GuardRef(i);
    if (r.G = nil) or (r.G^.Depth = 0) then Continue;
    Inc(Recoveries);
    s := Format('CAUGHT: call at %.8x (%s) never returned to its stub - fault %.8x at EIP %.8x | ' +
                'EAX %.8x EBX %.8x ECX %.8x EDX %.8x ESI %.8x EDI %.8x EBP %.8x ESP %.8x (stub ESP %.8x)',
                [r.Site, r.Name, code, c^.Eip, c^.Eax, c^.Ebx, c^.Ecx, c^.Edx, c^.Esi, c^.Edi, c^.Ebp, c^.Esp, r.G^.Esp]);
    JLog(s);
    s := 'stack at fault:';
    for k := -4 to 23 do
      if not IsBadReadPtr(Pointer(c^.Esp + Cardinal(k * 4)), 4) then
        s := s + Format(' %.8x', [PCardinal(c^.Esp + Cardinal(k * 4))^]);
    JLog(s);
    if Recoveries > 20 then
    begin
      JLog('too many recoveries this session - letting the game crash');
      Exit;
    end;
    c^.Esp := r.G^.Esp + r.ArgBytes;
    c^.Ebx := r.G^.Ebx;
    c^.Ebp := r.G^.Ebp;
    c^.Esi := r.G^.Esi;
    c^.Edi := r.G^.Edi;
    c^.Eax := r.OkEax;
    c^.Eip := r.G^.Ret;
    r.G^.Depth := 0;
    JLog(Format('resumed at %.8x as if the call had returned', [r.G^.Ret]));
    result := -1;                           // EXCEPTION_CONTINUE_EXECUTION
    Exit;
  end;
end;


function CallTargetIs(site, target : Cardinal) : boolean;
begin
  result := (PByte(site)^ = $E8) and
            (Cardinal(LongInt(site + 5) + PLongInt(site + 1)^) = target);
end;

Procedure OnInstall;
begin
  LogPath := ExtractFilePath(ParamStr(0)) + 'tplayx_joinguard.log';
  JLog('JoinGuard active: 6 calls in Network_Add_Player_Remote guarded');
  if VehHandle = nil then
    VehHandle := MyAddVEH(1, @JoinGuardVeh);
end;

Procedure OnUninstall;
begin
  if VehHandle <> nil then
  begin
    MyRemoveVEH(VehHandle);
    VehHandle := nil;
  end;
  if Repairs > 0 then
    JLog(Format('session end: %d stack repair(s)', [Repairs]));
end;

function GetPlugin : TPluginData;
begin
  result := nil;
  if not State_JoinGuard then Exit;
  if FileExists(ExtractFilePath(ParamStr(0)) + 'joinguard.off') then Exit;
  if not (CallTargetIs($00450CBB, $00451DF0) and
          CallTargetIs($00450CF6, $00451DF0) and
          CallTargetIs($00450D0B, $004618A0) and
          CallTargetIs($00450B6F, $004CA7C0) and
          CallTargetIs($00450C29, $00464290) and
          CallTargetIs($00450C3C, $004B6340)) then Exit;

  result := TPluginData.create( true,
                                'Join guard (16P join stack repair)',
                                State_JoinGuard,
                                @OnInstall, @OnUninstall );
  result.MakeStaticCall(State_JoinGuard, 'JoinGuard A', @StubA, $00450CBB);
  result.MakeStaticCall(State_JoinGuard, 'JoinGuard B', @StubB, $00450CF6);
  result.MakeStaticCall(State_JoinGuard, 'JoinGuard C', @StubC, $00450D0B);
  result.MakeStaticCall(State_JoinGuard, 'JoinGuard D', @StubD, $00450B6F);
  result.MakeStaticCall(State_JoinGuard, 'JoinGuard E', @StubE, $00450C29);
  result.MakeStaticCall(State_JoinGuard, 'JoinGuard F', @StubF, $00450C3C);
end;

end.
