type
  TGuardState = record
    Ret, Esp, Ebx, Ebp, Esi, Edi, Eax : Cardinal;
    BadEsp, BadEbx, BadEbp, BadEsi, BadEdi : Cardinal;
    Depth : Cardinal;
  end;

var
  GA, GB, GC, GD, GE, GF : TGuardState;
  LogPath    : string = '';
  Repairs    : Integer = 0;

procedure JLog(const s : string);
var
  f : TextFile;
begin
  if LogPath = '' then Exit;
  try
    AssignFile(f, LogPath);
    if FileExists(LogPath) then Append(f) else Rewrite(f);
    Writeln(f, FormatDateTime('hh:nn:ss', Now) + ' ' + s);
    CloseFile(f);
  except
  end;
end;

procedure ReportBad(const name : string; site : Cardinal; var g : TGuardState; argBytes : Cardinal);
begin
  Inc(Repairs);
  if Repairs > 200 then Exit;
  JLog(Format('REPAIRED call at %.8x (%s) #%d: ESP %.8x expected %.8x (diff %d) | ' +
              'EBX %.8x->%.8x EBP %.8x->%.8x ESI %.8x->%.8x EDI %.8x->%.8x | return %.8x',
              [site, name, Repairs, g.BadEsp, g.Esp + argBytes, Integer(g.BadEsp) - Integer(g.Esp + argBytes),
               g.Ebx, g.BadEbx, g.Ebp, g.BadEbp, g.Esi, g.BadEsi, g.Edi, g.BadEdi, g.Ret]));
end;

